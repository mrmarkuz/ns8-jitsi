{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>NethServer/.github:ns8-automerge"
    ],
    "packageRules": [
        {
            "matchDatasources": ["github-release"],
            "matchPackageNames": ["jitsi"],
            "versioning": "regex:^stable-(?<major>\\d+)(?:-(?<minor>\\d+))?$"
        }
    ]
}
