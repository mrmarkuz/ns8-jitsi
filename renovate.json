{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>NethServer/.github:ns8-automerge"
    ],
    "packageRules": [
        {
            "matchPackageNames": ["ghcr.io/jitsi/*"],
            "versioning": "regex:^stable-(?<major>\\d+)(?:-(?<minor>\\d+))?$",
			"groupName": "Jitsi"
        }
    ]
}
